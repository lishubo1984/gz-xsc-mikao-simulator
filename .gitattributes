# 统一换行符：入库时规范化为 LF，检出时按平台转换
* text=auto

# 明确二进制文件，禁止任何转换 / diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.rar binary
*.7z binary
*.gz  binary
*.tar binary
*.jar binary
*.war binary
*.exe binary
*.dll binary
*.so  binary
*.dylib binary
*.ttf binary
*.otf binary
*.woff  binary
*.woff2 binary
*.xlsx binary
*.docx binary
*.pptx binary

# Shell 脚本统一 LF（Windows 上写 Bash 脚本的必备项）
*.sh text eol=lf
*.bash text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
